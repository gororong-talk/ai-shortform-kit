#!/bin/bash
cat <<'__PREP_UPLOAD_EOF__' | pbcopy
1997년, IMF의 겨울. 치료비 512만원이 없어 병원 문 앞에서 쫓겨난 노인이, 그날 밤 정류장에서 얼어 죽었다.
"그냥 지병으로 돌아가셨다"는 병원. 하지만 지하에서 그를 씻기던 할머니가, 시신에서 이상한 것을 발견한다 — 주삿바늘 자국이, 하나도 없었다.

── 한성의료원 1997 ──
[1부] 그 밤, 한 사람이 쫓겨났다
[2부] 누구에겐 침대가 있었다
[3부] 18년 늦은 사과

🤖 AI로 만든 창작 드라마입니다. 가상의 인물·병원·사건이며 실제와 무관합니다.
#막장드라마 #오리지널드라마 #IMF #웹툰드라마 #반전결말 #AI드라마 #AI콘텐츠 #단편드라마
__PREP_UPLOAD_EOF__
echo "✅ 유튜브 설명이 클립보드에 복사됐습니다. 업로드 칸에 Cmd+V 로 붙여넣으세요."
nohup bash -c 'sleep 0.6; osascript -e "tell application \"Terminal\" to close front window"' >/dev/null 2>&1 &
