# cp .env.example .env 후 값 채우기. .env 는 절대 커밋하지 마세요(.gitignore 등록됨).

# ── 필수 ──
# 이미지 생성: https://fal.ai → Dashboard → Keys. 종량제(선불 충전).
FAL_KEY=
# 나레이션 TTS: https://fish.audio → API Keys. 종량제.
FISH_API_KEY=

# ── 선택 ──
# 스크립트에서 Claude를 직접 부를 때(CVDE 무인 채점, 이미지 검수, 자막 교정).
# Claude Code 안에서 스킬로 쓰면 필요 없다.
ANTHROPIC_API_KEY=
# 자막 타이밍 교정에 Gemini를 쓸 때(선택). 둘 다 같은 값 가능.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# 명언 트랙 배경음악(ACE Step). https://acemusic.ai 무료 키.
ACESTEP_API_KEY=
