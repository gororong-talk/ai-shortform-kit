{
  "_meta": {
    "provider": "Fish Audio S2-Pro",
    "endpoint": "POST https://api.fish.audio/v1/tts",
    "model_header": "s2-pro",
    "request": "raw REST, Content-Type application/json (msgpack은 references 클로닝 때만)",
    "key_env": "FISH_API_KEY (.env, 하드코딩 금지)",
    "cost": "~$0.02/분 (UTF-8 byte 과금). 월 20편 $1~2",
    "emotion_tags": "자유형 자연어 [bracket]: [excited][angry][sad][whispering][determined][calm] 등. 강도 [slightly]/[very]/[extremely]. 포즈 [break]/[long-break]",
    "updated": "2026-06-19",
    "safety": "★실존 인물(아이돌 karina/jisoo/haerin/노정의 등)·IP 캐릭터(Smash Bros/PaRappa/Alien stage/Cat Noir 등)·브랜드(배민광고) 보이스는 초상·저작권 위험으로 등록 제외. 아래는 모두 일반 설명형(비-실존).",
    "audition": "audition:true = 실제 들어본 것. false = 메타데이터만(쓰기 전 `scripts/fish_voice.py say <key>`로 청취 권장)",
    "sfx_note": "동물 보이스 = 동물 톤으로 '말하는' 음성. 진짜 짖는/우는 효과음(SFX) 아님 — SFX는 별도 소스 필요.",
    "pool_note": "자동수집(한국어 인기순). 실존인/IP/브랜드 denylist 1차 필터 통과분. ★사용 전 제목 직접 확인 권장(자동필터라 누락 가능). 청취=`scripts/fish_voice.py`는 voices(큐레이션)만 지원 → pool은 id로 직접 say 가능하게 추후 확장."
  },
  "assignments": {
    "sayeon_short": "f_soft_shorts",
    "sayeon_long": "f_storytelling",
    "wisdom": "f_anchor_calm",
    "kids_mascot_mascot": "char_cat_cute",
    "_note": "사연 숏폼=f_soft_shorts / 롱폼=f_storytelling / 명언=f_anchor_calm / 키즈 나레이션=kid_bright / 토리 마스코트=char_cat_cute. 2026-06-19 사용자 확정(나머지 추천대로). 상황별 교체는 pool에서.",
    "kids_narrator": "kid_bright"
  },
